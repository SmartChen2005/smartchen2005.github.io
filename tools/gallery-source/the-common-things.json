    {
      "id": "h.1073f1b2df18a84c_63",
      "items": [
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">Luccas Perez:</span>",
          "tag": "P",
          "text": "Luccas Perez:",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">Then there’s me,</span>",
          "tag": "P",
          "text": "Then there’s me,",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">Running, chasing</span>",
          "tag": "P",
          "text": "Running, chasing",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">It's always something</span>",
          "tag": "P",
          "text": "It's always something",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">Whether it was getting out of Broward</span>",
          "tag": "P",
          "text": "Whether it was getting out of Broward",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">Whether it was getting out of Atlantis</span>",
          "tag": "P",
          "text": "Whether it was getting out of Atlantis",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">Getting into college</span>",
          "tag": "P",
          "text": "Getting into college",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">Getting to this music</span>",
          "tag": "P",
          "text": "Getting to this music",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">Connecting with my dead</span>",
          "tag": "P",
          "text": "Connecting with my dead",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">Trying to inspire my youngins</span>",
          "tag": "P",
          "text": "Trying to inspire my youngins",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">Make a mannequin out of me</span>",
          "tag": "P",
          "text": "Make a mannequin out of me",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">It's always something</span>",
          "tag": "P",
          "text": "It's always something",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">But truly, it’s nothing</span>",
          "tag": "P",
          "text": "But truly, it’s nothing",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">I do more and more, and remain empty</span>",
          "tag": "P",
          "text": "I do more and more, and remain empty",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">The pursuit of knowledge, power, money, fame, self-fulfillment, some sense of satisfaction, simply to be satiated-</span>",
          "tag": "P",
          "text": "The pursuit of knowledge, power, money, fame, self-fulfillment, some sense of satisfaction, simply to be satiated-",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">I am a husk, my hunger is unsatiable</span>",
          "tag": "P",
          "text": "I am a husk, my hunger is unsatiable",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">However, my resolve is ever unbreakable</span>",
          "tag": "P",
          "text": "However, my resolve is ever unbreakable",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">I don’t think I'll ever find what I’m chasing, and that’s okay</span>",
          "tag": "P",
          "text": "I don’t think I'll ever find what I’m chasing, and that’s okay",
          "width": 0
        }
      ]
    }
  ],
