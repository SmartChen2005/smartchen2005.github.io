    {
      "id": "h.2a35da2b487baa31_62",
      "items": [
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"font-family: 'Playfair Display', Arial; font-weight: 700;\">Morning Unwoken</span><span class=\"C9DxTc \" style=\"\"> </span><span class=\"C9DxTc \" style=\"\">by Smart Chen</span>",
          "tag": "P",
          "text": "Morning Unwoken by Smart Chen",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">light is what falls</span>",
          "tag": "P",
          "text": "light is what falls",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">not what arrives</span>",
          "tag": "P",
          "text": "not what arrives",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">through branches</span>",
          "tag": "P",
          "text": "through branches",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">like an unfinished sentence</span>",
          "tag": "P",
          "text": "like an unfinished sentence",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">the lake has no language</span>",
          "tag": "P",
          "text": "the lake has no language",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">but remembers</span>",
          "tag": "P",
          "text": "but remembers",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">the outline of distant dreams</span>",
          "tag": "P",
          "text": "the outline of distant dreams",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">she emerges from the forest</span>",
          "tag": "P",
          "text": "she emerges from the forest",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">quiet</span>",
          "tag": "P",
          "text": "quiet",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">unhurried</span>",
          "tag": "P",
          "text": "unhurried",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">like a breath not yet finished</span>",
          "tag": "P",
          "text": "like a breath not yet finished",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">she looks toward nothing</span>",
          "tag": "P",
          "text": "she looks toward nothing",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">simply existing</span>",
          "tag": "P",
          "text": "simply existing",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">her gaze resting</span>",
          "tag": "P",
          "text": "her gaze resting",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">where light meets shadow</span>",
          "tag": "P",
          "text": "where light meets shadow",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">before the wind begins</span>",
          "tag": "P",
          "text": "before the wind begins",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">the world is already altered by her presence</span>",
          "tag": "P",
          "text": "the world is already altered by her presence",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">she is no illusion</span>",
          "tag": "P",
          "text": "she is no illusion",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">nor a memory</span>",
          "tag": "P",
          "text": "nor a memory",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">only the stillness</span>",
          "tag": "P",
          "text": "only the stillness",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">that becomes visible for an instant</span>",
          "tag": "P",
          "text": "that becomes visible for an instant",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">the wind</span>",
          "tag": "P",
          "text": "the wind",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">no answer</span>",
          "tag": "P",
          "text": "no answer",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">only tying knots in the empty air</span>",
          "tag": "P",
          "text": "only tying knots in the empty air",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">language arrives before silence</span>",
          "tag": "P",
          "text": "language arrives before silence",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">she is nothing but</span>",
          "tag": "P",
          "text": "she is nothing but",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">an unopened morning in your dream</span>",
          "tag": "P",
          "text": "an unopened morning in your dream",
          "width": 0
        }
      ]
    },
