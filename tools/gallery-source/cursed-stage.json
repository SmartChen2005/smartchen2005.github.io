    {
      "id": "h.35b5262c3394290b_14",
      "items": [
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">Twenty years ago, the most glamorous theatre in the capital was consumed by a raging fire.</span>",
          "tag": "P",
          "text": "Twenty years ago, the most glamorous theatre in the capital was consumed by a raging fire.",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">Its star performer — Jin Xiu — perished in the flames.</span>",
          "tag": "P",
          "text": "Its star performer — Jin Xiu — perished in the flames.",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">But her spirit never left.</span>",
          "tag": "P",
          "text": "But her spirit never left.",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">They say that every Halloween night, faint echoes of her singing drift through the ruins…</span>",
          "tag": "P",
          "text": "They say that every Halloween night, faint echoes of her singing drift through the ruins…",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">This Halloween —</span>",
          "tag": "P",
          "text": "This Halloween —",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">will you dare to enter the theatre cursed by Jin Xiu’s final performance?</span>",
          "tag": "P",
          "text": "will you dare to enter the theatre cursed by Jin Xiu’s final performance?",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">A group of college students on an adventure.</span>",
          "tag": "P",
          "text": "A group of college students on an adventure.",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">A dangerous séance.</span>",
          "tag": "P",
          "text": "A dangerous séance.",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">A truth buried beneath ash and sorrow.</span>",
          "tag": "P",
          "text": "A truth buried beneath ash and sorrow.",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">In the darkness, the story awaits you.</span>",
          "tag": "P",
          "text": "In the darkness, the story awaits you.",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">Here, you are not just the audience —</span>",
          "tag": "P",
          "text": "Here, you are not just the audience —",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">you are part of the tale.</span>",
          "tag": "P",
          "text": "you are part of the tale.",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">Perhaps the leader of the expedition,</span>",
          "tag": "P",
          "text": "Perhaps the leader of the expedition,",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">perhaps the one possessed,</span>",
          "tag": "P",
          "text": "perhaps the one possessed,",
          "width": 0
        },
        {
          "alt": "",
          "height": 0,
          "html": "<span class=\"C9DxTc \" style=\"\">or perhaps… </span><span class=\"C9DxTc \" style=\"font-family: 'Playfair Display', Arial; font-weight: 700;\">the chosen substitute — handpicked by Jin Xiu herself.</span>",
          "tag": "P",
          "text": "or perhaps… the chosen substitute — handpicked by Jin Xiu herself.",
          "width": 0
        },
